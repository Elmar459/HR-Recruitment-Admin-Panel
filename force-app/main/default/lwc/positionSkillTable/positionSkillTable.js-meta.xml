                <object>Position__c</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightning__AppPage, lightning__HomePage">
            <property name="recordId" type="String" label="Position ID" description="Provide the Position ID manually" required="true"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>